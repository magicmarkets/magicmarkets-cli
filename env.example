# Magic Markets API configuration
#
# Copy to .env and fill in your key:
#     cp env.example .env
#
# magicmarkets reads, in order of precedence:
#   1. real environment variables
#   2. ./.env
#   3. ~/.magicmarkets/.env
#   4. ~/.env
#
# Keep .env out of version control — it is already in .gitignore.

# Your API key. Create one at magicmarkets.com under Settings -> API.
# It is shown ONCE at creation, so store it immediately.
MAGICMARKETS_API_KEY=

# OAuth access token, as an alternative to MAGICMARKETS_API_KEY for the CLI
# and stdio MCP. HTTP MCP still takes X-Api-Key or Authorization: Bearer per
# request and does not read this.
# MAGICMARKETS_ACCESS_TOKEN=

# Upstream Magic Markets Authorization Server. HTTP MCP proxies /authorize
# and /token here. Discovery still names the MCP host as the issuer so
# Claude's Dynamic Client Registration hits this process, not magicmarkets.com.
# Default: https://magicmarkets.com/api/auth
# MAGICMARKETS_OAUTH_ISSUER=https://magicmarkets.com/api/auth

# Public base of the HTTP MCP listener (no /mcp suffix). For sports-dev:
# MAGICMARKETS_MCP_PUBLIC_URL=https://magicmarkets-mcp.dev-eu.kubershmuber.com

# Pre-registered public client on MAGICMARKETS_OAUTH_ISSUER, whose
# redirect_uris allowlist includes THIS process's own callback
# ({MAGICMARKETS_MCP_PUBLIC_URL}/mcp/callback) — never a downstream client's.
# MAGICMARKETS_OAUTH_CLIENT_ID=

# Seals the HTTP MCP OAuth proxy's DCR client_ids, in-flight login state, and
# one-time codes so no server-side session store is needed. Every replica of
# a multi-replica deployment MUST share this value, or a request routed to a
# different replica than the one that minted a token can't decode it. Safe
# to leave unset for a single local process (a random per-process key is
# used instead) but not for the hosted, multi-replica deployment.
# MAGICMARKETS_OAUTH_PROXY_SECRET=

# Environment-specific id used to build the `session` value an OAuth Bearer
# credential resolves to ("m-<group id>-<user uuid>"). Required for Bearer
# auth; it differs per environment and has no safe default.
# MAGICMARKETS_SESSION_GROUP_ID=

# Firebase Web API key for the Magic Markets Firebase project, used to
# redeem the Firebase custom token from /oauth2/firebase-token for a real
# Firebase ID token. Required for Bearer auth; it differs per environment
# and has no safe default.
# MAGICMARKETS_FIREBASE_WEB_API_KEY=

# REST base URL, including the /v2 suffix.
# Default: https://magicmarkets.com/v2
# MAGICMARKETS_API_URL=https://magicmarkets.com/v2

# WebSocket stream endpoint.
# Derived from MAGICMARKETS_API_URL when unset (https -> wss, plus /stream).
# MAGICMARKETS_WS_URL=wss://magicmarkets.com/v2/stream

# Language for event and competition names on the stream: en, ko, zh-hans.
# MAGICMARKETS_LANG=en

# Per-request timeout, as a Go duration.
# MAGICMARKETS_TIMEOUT=30s

# Let `magicmarkets mcp` place real bets (stdio MCP tools). Off unless set.
# Affects the stdio subprocess only, never the CLI. Accepts 1/true/yes/on and
# 0/false/no/off.
# MAGICMARKETS_ALLOW_TRADING=1
